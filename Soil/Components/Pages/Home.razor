@page "/"
@using Soil.Models
@using Soil.Services.Interface
@inject ISoilService SoilService
@rendermode InteractiveServer
@implements IDisposable 


<PageTitle> Soil Monitor</PageTitle>

<div class="container-main">
    <h1>Soil Status</h1>
    
    <div class="Box-tl">
        <h2> Latest Reading - Satemin </h2>
        @if (loading)
        {
            <p>Loading data...</p>
        }
        else
        {
            <div class="reading-grid">
                @if (surfaceReading != null)
                {
                    <div class="readingContent">
                        <span class="moisture-text">@surfaceReading.Depth.ToString("0.0") cm</span>
                        <span class="moistureValue">@surfaceReading.MoistureLevel.ToString("0.000") m³/m³</span>
                        <p class="time-text">Measured at: @surfaceReading.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</p>
                    </div>
                }

                @if (undergroundReading != null)
                {
                    <div class="readingContent">
                        <span class="moisture-text">@undergroundReading.Depth.ToString("0.0") cm</span>
                        <span class="moistureValue">@undergroundReading.MoistureLevel.ToString("0.000") m³/m³</span>
                        <p class="time-text">Measured at: @undergroundReading.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</p>
                    </div>
                }
            </div>
        }
    </div>
    
    
    <div class="Box-tr">
        <h2> Data History </h2>
        @if (history.Count == 0)
        {
            <p>No history yet</p>
        }
        else
        {
            <table>
                <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>Moisture</th>
                    <th>Depth</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var reading in history)
                {
                    <tr>
                        <td>@reading.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td>@reading.MoistureLevel.ToString("0.000") m³/m³</td>
                        <td>@reading.Depth.ToString("0") cm</td>
                    </tr>
                }
                </tbody>
            </table>
        }
       
    </div>
    
    <div class="Box-bl">
        <h2> Graph of data points </h2>
        @if (!loading)
        {
            <PlotlyChart @bind-Config="config"
                         @bind-Layout="layout"
                         @bind-Data="graphData"></PlotlyChart>
            
        }
    </div>
    
    
    <div class="Box-br">

        <h2>Too Dry - Alarm</h2>

        @if (alarmActive)
        {
            <div class="alarm-box">
                <p>⚠️ Moisture below threshold!</p>
            </div>
        }

        @if (messageSent)  
        {
            <p style="color: green; font-weight: bold; text-align: center;">✅ Message sent to operator!</p>
        }

        <button @onclick="SendNotification">Send operator to water</button>

    </div>
    

</div>

@code {

    private SoilMoistureReading? surfaceReading;
    private SoilMoistureReading? undergroundReading;
    private List<SoilMoistureReading> history = new();
    private Plotly.Blazor.Config config = new();
    private IList<ITrace> graphData = new List<ITrace>();
    private PeriodicTimer? timer;
    private const double Threshold = 0.100;
    private bool alarmActive = false; 
    private bool messageSent = false; 
    
    private Plotly.Blazor.Layout layout = new()
    {
        Height = 300,
        AutoSize = true,
        Margin = new() { L = 50, R = 20, T = 20, B = 80 }, 
        Font = new Plotly.Blazor.LayoutLib.Font { Color = "#a0b4c8" }, 
        XAxis = new List<XAxis>
        {
            new XAxis
            {
                TickAngle = -45,
                GridColor = "#1e3a5f", 
                LineColor = "#1e3a5f"   
            }
        },
        YAxis = new List<YAxis> 
        {
            new YAxis
            {
                GridColor = "#1e3a5f",
                LineColor = "#1e3a5f"
            }
        }
    };

    private void BuildGraph()
    {
        var surfacePoints = history
            .Where(r => r.Depth == 1).OrderBy(r => r.Timestamp).ToList();
        
        var undergroundPoints = history
            .Where(r => r.Depth == 54).OrderBy(r => r.Timestamp).ToList();

        graphData = new List<ITrace>
        {
            new Scatter
            {
                Name = "Surface (1cm)",
                X = surfacePoints.Select(r => (object)r.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")).ToList(),
                Y = surfacePoints.Select(r => (object)r.MoistureLevel).ToList(),
                Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines,
                Line = new Plotly.Blazor.Traces.ScatterLib.Line 
                {
                    Color = "#4fc3f7"  
                }
            },
            new Scatter
            {
                Name = "Underground (54cm)",
                X = undergroundPoints.Select(r => (object)r.Timestamp.ToLocalTime().ToString("dd/MM HH:mm")).ToList(),
                Y = undergroundPoints.Select(r => (object)r.MoistureLevel).ToList(),
                Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines,
                Line = new Plotly.Blazor.Traces.ScatterLib.Line 
                {
                    Color = "#ff7043" 
                }
            }
        };
    }
    

    private async Task LoadData()
    {
        await SoilService.SaveReadingAsync();
        surfaceReading = await SoilService.GetLatestByDepthAsync(1);
        undergroundReading = await SoilService.GetLatestByDepthAsync(54);
        history = await SoilService.GetHistoryAsync();
        BuildGraph();

        if (surfaceReading != null && surfaceReading.MoistureLevel < Threshold)
        {
            Console.WriteLine($"ALARM: Surface moisture is below threshold! Value: {surfaceReading.MoistureLevel}");
            alarmActive = true;
        }
        else
        {
            alarmActive = false;
        }

        loading = false;
    }

    private void SendNotification() 
    {
        Console.WriteLine("NOTIFICATION: Operator has been contacted to water.");
        messageSent = true;
    }


    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
            await LoadData();
            timer = new PeriodicTimer(TimeSpan.FromMinutes(60));
            _ = Task.Run(async () =>
            {
                while (await timer.WaitForNextTickAsync())
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            });
    }

    public void Dispose()
    {
        timer.Dispose();
    }

}